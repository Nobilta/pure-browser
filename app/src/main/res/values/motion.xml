<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dialog window's own animation, for the sheet windows Compose cannot animate itself.

      The entrance is deliberately @null: every sheet a route presents runs its entrance in Compose,
      where it can be spring-driven, reversible, and shared with the dismissal gesture. A window
      animation on top of that would play the arrival a second time. Only the exit needs one, and
      only because some sheets leave by being unmounted — see anim/browser_sheet_exit.xml, which
      has to match the Compose-driven exit in direction and curve.
    -->
    <style name="BrowserSheetAnimation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@anim/browser_sheet_exit</item>
    </style>
</resources>
