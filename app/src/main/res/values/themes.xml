<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the UI; this platform theme styles the launch window. -->
    <style name="Theme.MyBrowser.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.MyBrowser" parent="Theme.MyBrowser.Base">
        <item name="android:windowBackground">#F9F9FF</item>
    </style>
    <style name="Theme.MyBrowser.Cast" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
