<?xml version="1.0" encoding="utf-8"?>
<!--
  Pure's launcher mark: a rounded browser window with a friendly P/leaf monogram.
  The artwork stays inside the adaptive icon safe zone so circular and squircle launchers
  do not crop the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft browser-window tile. -->
    <path
        android:fillColor="#F8FFFC"
        android:fillAlpha="0.97"
        android:pathData="M31,25 C31,21.7 33.7,19 37,19 L71,19 C74.3,19 77,21.7 77,25 L77,83 C77,86.3 74.3,89 71,89 L37,89 C33.7,89 31,86.3 31,83 Z" />

    <!-- Minimal browser chrome. -->
    <path
        android:fillColor="#8ADCCB"
        android:pathData="M36,29 L72,29 L72,34 L36,34 Z" />
    <path
        android:fillColor="#0F766E"
        android:pathData="M38,31.5 A2,2 0 1,0 42,31.5 A2,2 0 1,0 38,31.5" />
    <path
        android:fillColor="#2FB7A5"
        android:pathData="M44,31.5 A2,2 0 1,0 48,31.5 A2,2 0 1,0 44,31.5" />

    <!-- P monogram, drawn as a single rounded stroke for a crisp small-size silhouette. -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#0F766E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M43,76 L43,43 L56,43 C65,43 70,47.5 70,54.5 C70,61.5 65,66 56,66 L43,66" />

    <!-- Leaf accent: the mark reads as both a P and a calm, living browser. -->
    <path
        android:fillColor="#2FB7A5"
        android:pathData="M61,69 C68,68 75,72 77,80 C69,80 63,76 61,69 Z" />
    <path
        android:fillColor="#0F766E"
        android:pathData="M63,71 L74,78 L64,75 Z" />
</vector>
