<?xml version="1.0" encoding="utf-8"?>
<!--
  A sheet leaving towards the bottom edge, for the windows Compose does not animate itself.

  The route host owns the exit of every destination it presents, so this covers only the surfaces
  a page opens on its own — a picker inside settings, for instance — which leave by being unmounted
  and have nothing left composed to run a spring on.

  It therefore has to match what those same sheets do when Compose does drive them: a surface
  travels towards the edge it came from while it fades, rather than fading on the spot. The
  interpolator is fast_out_slow_in rather than the fast_out_linear_in this used to carry: a spring
  leaving from rest starts with no velocity and arrives with none, and that curve is flat at both
  ends where fast_out_linear_in is not — the old one eased like a surface being thrown away instead
  of one being lowered out of the way.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="250"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" />
    <translate android:fromYDelta="0%" android:toYDelta="40%" />
</set>
